# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Connection pooling URL (e.g. PgBouncer, Neon pooled connection, Prisma Accelerate)
# Use this for application querying to prevent connection exhaustion in serverless environments.
DATABASE_URL="postgres://[db-user]:[db-password]@[db-host]:[db-port]/[db-name]?pgbouncer=true"

# Direct URL for Prisma migrations 
# Migrations cannot run over a pooled connection easily, so provide the direct DB URL here.
DIRECT_URL="postgres://[db-user]:[db-password]@[db-host]:[db-port]/[db-name]"

# JWT & Payments Setup
JWT_SECRET="super-secret-jwt-key"
# Razorpay Authentication (TEST MODE)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_custom_webhook_secret_here"
